<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase necesita salida a internet para autenticar y sincronizar. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Desde Android 13 mostrar notificaciones requiere que la persona lo autorice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para abrir la cámara del sistema desde la hoja de gasto. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".Aplicacion"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Finanzas">

        <!-- Identificador de la aplicación en AdMob. Lo reemplaza el valor de local.properties si existe. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Notificaciones de Firebase: canal, ícono y color de las que muestra el sistema
             cuando la aplicación está cerrada. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="novedades" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/verde" />

        <!-- Recibe los mensajes de las campañas cuando la aplicación está abierta. -->
        <service
            android:name=".ServicioMensajes"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Pantalla de entrada. Decide si mostrar el acceso o ir directo al resumen. -->
        <!-- singleTask: al tocar una campaña con la aplicación en segundo plano, el sistema
             vuelve a pasar por acá con los datos de la notificación en lugar de solo traer
             la tarea al frente, que los descartaría. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Resumen del mes y lista de gastos. Sólo se abre con sesión iniciada. -->
        <activity
            android:name=".PrincipalActivity"
            android:exported="false" />

        <!-- Todos los gastos del tramo, con buscador. -->
        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:parentActivityName=".PrincipalActivity" />

        <!-- Administración de las categorías propias del usuario. -->
        <activity
            android:name=".CategoriasActivity"
            android:exported="false"
            android:parentActivityName=".PrincipalActivity" />

        <!-- Ingresos, presupuesto, gastos fijos y copia de los datos. -->
        <activity
            android:name=".AjustesActivity"
            android:exported="false"
            android:parentActivityName=".PrincipalActivity" />

        <!-- Entrega a la cámara el archivo donde dejar la foto del ticket. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>

    </application>

</manifest>
