<?xml version="1.0" encoding="utf-8"?>
<!-- Va dentro de un contenedor desplazable: con el teclado abierto, el botón de
     guardar quedaba tapado y no había manera de llegar a él. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/superficie">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Barrita de arrastre, la señal de que la hoja se cierra deslizando -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/borde" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/nuevo_gasto"
            android:textAppearance="@style/Texto.Titulo" />

        <!-- El monto es lo primero y lo más grande: es el único dato obligatorio. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/signo_pesos"
                android:textColor="@color/texto_suave"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/etMonto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_bold"
                android:hint="@string/cero"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:digits="0123456789.,"
                android:maxLength="14"
                android:textColor="@color/texto"
                android:textColorHint="@color/borde"
                android:textSize="42sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borde" />

        <!-- Casi nadie anota en el momento de pagar: la mayoría carga a la noche o
             el fin de semana, así que la fecha tiene que poder corregirse. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFecha"
                style="@style/Boton.Blanco"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                app:icon="@drawable/ic_calendario"
                app:iconSize="18dp"
                app:iconTint="@color/texto_suave" />

            <!-- Lee el importe de un ticket con ML Kit. Sólo en gastos nuevos. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanear"
                style="@style/Boton.Blanco"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/escanear_ticket"
                android:textSize="14sp"
                app:icon="@drawable/ic_camara"
                app:iconSize="18dp"
                app:iconTint="@color/texto_suave" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/categoria"
            android:textAppearance="@style/Texto.Seccion" />

        <!-- Las categorías del usuario. Sin lista desplegable: se elige de un toque. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/medio_pago"
            android:textAppearance="@style/Texto.Seccion" />

        <!-- Las fichas se arman en el código: los medios los define el usuario. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoMedios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:singleSelection="true" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDetalle"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/detalle_opcional"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            style="@style/Boton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/btn_guardar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBorrar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/borrar_gasto"
            android:textAllCaps="false"
            android:textColor="@color/rojo"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
