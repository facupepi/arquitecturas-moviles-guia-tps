<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/desplazable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="150dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <!-- Encabezado. Los accesos a otras pantallas se mudaron al menú de
                 abajo: acá eran dos botones sin texto que nadie entendía. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/Texto.Titulo"
                    tools:text="Hola, Facundo" />

                <TextView
                    android:id="@+id/tvCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/Texto.Apoyo"
                    tools:text="alguien@gmail.com" />

            </LinearLayout>

            <!-- Qué período se está mirando. Sale del borde para que se note que la
                 fila sigue y se puede desplazar. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoPeriodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEsteMes"
                        style="@style/ChipPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/periodo_este_mes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMesPasado"
                        style="@style/ChipPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/periodo_mes_pasado" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEsteAnio"
                        style="@style/ChipPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/periodo_este_anio" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodo"
                        style="@style/ChipPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/periodo_todo" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- La cifra del período. Con ingresos cargados pasa a ser el saldo. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/verde"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/tvRotulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.75"
                            android:fontFamily="@font/poppins_semibold"
                            android:letterSpacing="0.06"
                            android:text="@string/gastado_este_mes"
                            android:textAllCaps="true"
                            android:textColor="@color/blanco"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/Texto.Cifra"
                            android:textColor="@color/blanco"
                            tools:text="$473.700" />

                        <TextView
                            android:id="@+id/tvCantidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/blanco"
                            android:textSize="14sp"
                            tools:text="7 movimientos registrados" />
                        <!-- El equivalente en dólares, con la misma estructura que las filas de ingresos y gastos. -->
                        <LinearLayout
                            android:id="@+id/bloqueDolares"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:alpha="0.25"
                                android:background="@color/blanco" />

                            <include
                                android:id="@+id/filaDolares"
                                layout="@layout/fila_desglose"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp" />

                            <!-- Alineado con el texto de la fila: 18 dp del ícono y 10 dp de separación. -->
                            <TextView
                                android:id="@+id/tvDolaresDetalle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="28dp"
                                android:layout_marginTop="4dp"
                                android:alpha="0.75"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/blanco"
                                android:textSize="12sp"
                                tools:text="Cotización de $1.560, según DolarAPI al 26/10/2026." />

                        </LinearLayout>

                        <!-- El desglose. Antes iba todo en una línea separada por
                             puntos medios y costaba leerlo; ahora cada dato tiene
                             su renglón y su ícono. -->
                        <LinearLayout
                            android:id="@+id/bloqueDesglose"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:alpha="0.25"
                                android:background="@color/blanco" />

                            <include
                                android:id="@+id/filaIngresos"
                                layout="@layout/fila_desglose"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp" />

                            <include
                                android:id="@+id/filaGastos"
                                layout="@layout/fila_desglose"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Distribución por categoría. Sólo aparece si hay algo que repartir. -->
                <LinearLayout
                    android:id="@+id/bloqueGrafico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="@string/en_que_se_fue"
                        android:textAppearance="@style/Texto.Seccion" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Tarjeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <!-- Apilado: el anillo arriba y la leyenda debajo. Al costado
                             la leyenda quedaba angosta y los nombres se cortaban. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingTop="22dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="14dp">

                            <ar.edu.utn.frsfco.finanzas.GraficoAnillo
                                android:id="@+id/grafico"
                                android:layout_width="168dp"
                                android:layout_height="168dp"
                                android:layout_gravity="center_horizontal" />

                            <LinearLayout
                                android:id="@+id/leyenda"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:orientation="vertical" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                                <!-- Evolución del gasto: el ritmo del mes en curso y el último mes con inflación publicada. -->
                <LinearLayout
                    android:id="@+id/bloqueInflacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="@string/inflacion_titulo"
                        android:textAppearance="@style/Texto.Seccion" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Tarjeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <include
                                android:id="@+id/filaEvolucion"
                                layout="@layout/fila_comparacion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvVeredicto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/fondo_etiqueta"
                                android:fontFamily="@font/poppins_medium"
                                android:paddingStart="12dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="6dp"
                                android:textSize="12sp"
                                tools:text="El gasto disminuyó" />

                            <TextView
                                android:id="@+id/tvNotaInflacion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:lineSpacingExtra="2dp"
                                android:textAppearance="@style/Texto.Apoyo"
                                tools:text="La inflación de octubre aún no está publicada." />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
                <!-- Título de la lista, con el filtro activo si hay uno -->
                <LinearLayout
                    android:id="@+id/tituloLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTituloLista"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ultimos_gastos"
                        android:textAppearance="@style/Texto.Seccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuitarFiltro"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:fontFamily="@font/poppins_medium"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/quitar_filtro"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tarjetaLista"
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/lista"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_gasto" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerTodos"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_medium"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:visibility="gone"
                            tools:text="Ver los 32 movimientos" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Cuando no hay nada para mostrar -->
                <LinearLayout
                    android:id="@+id/vacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="176dp"
                        android:layout_height="136dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ilustracion_sin_gastos" />

                    <TextView
                        android:id="@+id/tvVacioTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/chanchito_titulo"
                        android:textAlignment="center"
                        android:textColor="@color/texto"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/tvVacioBajada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="24dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/chanchito_bajada"
                        android:textAlignment="center"
                        android:textAppearance="@style/Texto.Apoyo" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnAgregar"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/btn_agregar"
        android:textAllCaps="false"
        android:textColor="@color/blanco"
        android:textSize="16sp"
        app:backgroundTint="@color/verde"
        app:cornerRadius="18dp"
        app:elevation="6dp"
        app:icon="@drawable/ic_agregar"
        app:iconTint="@color/blanco" />

    <include
        android:id="@+id/navegacion"
        layout="@layout/barra_navegacion" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
