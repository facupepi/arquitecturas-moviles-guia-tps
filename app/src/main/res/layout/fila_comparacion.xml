<?xml version="1.0" encoding="utf-8"?>
<!-- Una comparación del gasto: ícono de tendencia, etiqueta, valor y detalle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/fondo_circulo"
        android:contentDescription="@null"
        android:padding="11dp"
        tools:src="@drawable/ic_tendencia_baja" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEtiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/texto_suave"
            android:textSize="11sp"
            tools:text="Septiembre frente a agosto" />

        <TextView
            android:id="@+id/tvValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="22sp"
            tools:text="25,0 % menos"
            tools:textColor="@color/verde" />

        <TextView
            android:id="@+id/tvDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/texto_suave"
            android:textSize="13sp"
            tools:text="Inflación de septiembre: 1,9 %." />

    </LinearLayout>

</LinearLayout>