rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario entra únicamente a lo que cuelga de su identificador.
    // Sin sesión iniciada no se lee ni se escribe nada.
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function montoValido() {
      return request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000000;
    }

    match /usuarios/{uid}/gastos/{gasto} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && montoValido()
        && request.resource.data.keys().hasOnly([
          'monto', 'categoria', 'detalle', 'fecha', 'medioId', 'fijoId'
        ])
        && request.resource.data.keys().hasAll(['monto', 'categoria', 'detalle', 'fecha'])
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() > 0
        && request.resource.data.categoria.size() <= 40
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() <= 120
        && request.resource.data.fecha is timestamp
        && (!('medioId' in request.resource.data)
            || (request.resource.data.medioId is string
                && request.resource.data.medioId.size() <= 40))
        && (!('fijoId' in request.resource.data)
            || (request.resource.data.fijoId is string
                && request.resource.data.fijoId.size() <= 40));
    }

    match /usuarios/{uid}/ingresos/{ingreso} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && montoValido()
        && request.resource.data.keys().hasOnly(['monto', 'detalle', 'fecha'])
        && request.resource.data.keys().hasAll(['monto', 'detalle', 'fecha'])
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() <= 120
        && request.resource.data.fecha is timestamp;
    }

    match /usuarios/{uid}/categorias/{categoria} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'color', 'icono', 'orden'])
        && request.resource.data.keys().hasAll(['nombre', 'color', 'icono', 'orden'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 20
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.icono is string
        && request.resource.data.icono.size() <= 20
        && request.resource.data.orden is int;
    }

    // Medios de pago propios de cada usuario.
    match /usuarios/{uid}/medios/{medio} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'color', 'icono', 'orden'])
        && request.resource.data.keys().hasAll(['nombre', 'color', 'icono', 'orden'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 24
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.icono is string
        && request.resource.data.icono.size() <= 20
        && request.resource.data.orden is int;
    }

    // Gastos que se repiten todos los meses. El día tiene que existir en un mes.
    match /usuarios/{uid}/fijos/{fijo} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && montoValido()
        && request.resource.data.keys().hasOnly([
          'nombre', 'monto', 'categoria', 'medioId', 'diaDelMes', 'omitidoMes'
        ])
        && request.resource.data.keys().hasAll([
          'nombre', 'monto', 'categoria', 'medioId', 'diaDelMes'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.categoria is string
        && request.resource.data.medioId is string
        && request.resource.data.medioId.size() <= 40
        && request.resource.data.diaDelMes is int
        && request.resource.data.diaDelMes >= 1
        && request.resource.data.diaDelMes <= 31
        && (!('omitidoMes' in request.resource.data)
            || (request.resource.data.omitidoMes is string
                && request.resource.data.omitidoMes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')));
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
